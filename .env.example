# ---------------------------------------------------------------------------
# Client (Vite) — must be prefixed VITE_ to be exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL for the Sherpa-ONNX streaming ASR WebAssembly bundle.
# Leave unset for the self-hosted default. The version is part of the path
# because these files are served immutable — see docs/MODELS.md.
VITE_SHERPA_ASR_BASE=/models/asr-v1.13.6

# Base URL for the Sherpa-ONNX TTS WebAssembly bundle.
VITE_SHERPA_TTS_BASE=/models/tts-v1.12.37

# Optional Silero VAD bundle.
VITE_SHERPA_VAD_BASE=/models/vad-v1.13.6

# Optional second-pass (offline, punctuation-restoring) recogniser bundle.
# Unset disables the two-pass architecture.
VITE_SHERPA_REFINE_BASE=

# WebSocket signalling endpoint. Unset => same-origin /signal
VITE_SIGNALING_URL=

# ICE servers as JSON. STUN is free; TURN requires your own coturn deployment.
VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# ---------------------------------------------------------------------------
# Server (runtime)
# ---------------------------------------------------------------------------

PORT=8080
# require-corp (spec default) | credentialless (needed for third-party model CDNs)
COEP_MODE=require-corp
# Set to "false" to run the origin without the bundled signalling WebSocket.
ENABLE_SIGNALING=true
# Optional Redis fan-out so multiple signalling replicas share rooms.
REDIS_URL=
