{
  "name": "webmcp-aac",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Blueprint 2 \u2014 Context-Aware AAC via WebRTC Edge AI (Sherpa-ONNX WASM + WebMCP)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/copy-ort-assets.mjs && vite",
    "build": "tsc --noEmit && node scripts/copy-ort-assets.mjs && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:egress": "node scripts/audit-egress.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "verify": "npm run typecheck && npm run test && npm run audit:egress",
    "upload:models": "node scripts/upload-models.mjs",
    "setup:gcp": "bash scripts/setup-gcp.sh",
    "postinstall": "node scripts/copy-ort-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
