{
  "name": "webmcp-aac",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Blueprint 2 — Context-Aware AAC via WebRTC Edge AI (Sherpa-ONNX WASM + WebMCP)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/copy-ort-assets.mjs && vinext dev",
    "build": "tsc --noEmit && node scripts/copy-ort-assets.mjs && vinext build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:egress": "node scripts/audit-egress.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "verify": "npm run typecheck && npm run test && npm run audit:egress",
    "upload:models": "node scripts/upload-models.mjs",
    "setup:gcp": "bash scripts/setup-gcp.sh",
    "postinstall": "node scripts/copy-ort-assets.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.26",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1",
    "wrangler": "4.92.0"
  }
}
